{
  "name": "vulnsight-ai",
  "version": "0.1.0",
  "description": "Open-source dependency vulnerability scanner for npm and Python projects, powered by OSV.dev",
  "license": "MIT",
  "bin": {
    "vulnsight": "bin/vulnsight.js"
  },
  "main": "src/index.js",
  "files": [
    "bin",
    "src",
    "ui"
  ],
  "scripts": {
    "test": "node --test \"test/**/*.test.js\"",
    "ui": "node bin/vulnsight.js ui",
    "scan:examples": "node bin/vulnsight.js test examples/npm-app && node bin/vulnsight.js test examples/python-app",
    "ops": "node scripts/ops.js",
    "loadtest": "node scripts/loadtest.js",
    "probe": "node scripts/security-probe.js",
    "probe:xss": "node scripts/xss-probe.js"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "security",
    "vulnerability",
    "scanner",
    "sca",
    "osv",
    "npm",
    "pypi"
  ]
}
