{
  "name": "vulnsight-ai",
  "version": "0.1.0",
  "description": "VulnSight-AI: Proof-of-concept dependency vulnerability scanner for open-source npm projects using OSV.dev",
  "main": "src/index.js",
  "type": "module",
  "bin": {
    "vulnsight": "./bin/scanner.js",
    "vuln-scanner": "./bin/scanner.js"
  },
  "scripts": {
    "start": "node bin/scanner.js",
    "test": "node --test tests/",
    "scan": "node bin/scanner.js .",
    "scan:vulnerable": "node bin/scanner.js ./test-fixtures/vulnerable-npm-project",
    "scan:clean": "node bin/scanner.js ./test-fixtures/clean-npm-project"
  },
  "keywords": [
    "vulnerability-scanner",
    "sca",
    "osv",
    "security",
    "npm",
    "dependencies",
    "cve"
  ],
  "author": "Antigravity Engineering",
  "license": "MIT",
  "dependencies": {
    "picocolors": "^1.1.1",
    "semver": "^7.8.5"
  }
}
